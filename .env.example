# Chiave API Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modello (default: claude-opus-5)
SGS_MODELLO=claude-opus-5

# Cartella dei documenti SGS da indicizzare
SGS_DOCUMENTI=./documenti

# Database SQLite
SGS_DB=./sgs_live.db

# Porta del server locale
SGS_PORTA=8770

# ─── Dove stanno i documenti del SGS ────────────────────────────────────────
# Una o più cartelle, separate da «;». Vengono LETTE e mai modificate.
# Possono essere cartelle locali, unità di rete mappate o percorsi UNC.
#   Windows : SGS_DOCUMENTI=\\srv-file\SGS\Documentazione;S:\SGS\Registri
#   Linux   : SGS_DOCUMENTI=/mnt/sgs/documentazione;/mnt/sgs/registri
#   macOS   : SGS_DOCUMENTI=/Volumes/SGS/Documentazione
SGS_DOCUMENTI=./documenti

# Sola lettura: disattiva il caricamento di file dalla dashboard, così nulla
# viene mai scritto nelle cartelle sorgente. Consigliato su condivisioni di rete.
SGS_SOLA_LETTURA=0

# Cartella in cui atterrano i file caricati dalla dashboard quando SGS_SOLA_LETTURA=0.
# Se omessa coincide con la prima cartella sorgente.
#SGS_CARTELLA_CARICAMENTI=./documenti

# File e cartelle da non indicizzare mai (glob, separati da «;»).
# Utile per tenere fuori dall'indice i documenti con dati personali o sanitari.
SGS_ESCLUDI=~$*;*.tmp;*.bak;.*;Archivio storico*;Riservato*;Dati personali*;*Bozza*

# ─── Modalità di funzionamento ──────────────────────────────────────────────
# assistito = ricerca locale + risposte in linguaggio naturale (i passaggi
#             recuperati vengono inviati all'API Anthropic)
# locale    = nessuna chiamata esterna: solo ricerca full-text e registri
SGS_MODALITA=assistito

# Necessaria solo con SGS_MODALITA=assistito — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
SGS_MODELLO=claude-opus-5

# ─── Server e archivio ──────────────────────────────────────────────────────
# Database locale (indice, registri, log di tracciabilità).
SGS_DB=./sgs_live.db
# 127.0.0.1 = raggiungibile solo da questo PC. Cambiare solo se serve l'accesso
# da altre postazioni, previa valutazione con IT (il server non ha autenticazione).
SGS_INDIRIZZO=127.0.0.1
SGS_PORTA=8770
